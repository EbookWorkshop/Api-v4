flowchart TB
    subgraph External["🌐 外部请求"]
        User[浏览器 / 前端]
    end

    subgraph Layer1["1_Interfaces（接口适配层）"]
        Controller[BookController]
        Router[Router]
        DTO[DTOs]
    end

    subgraph Layer2["2_Application（应用服务层）"]
        Service[BookQueryService]
        Ports[Ports 抽象接口]
    end

    subgraph Layer3["3_Domain（领域模型层）"]
        Entity[EbookEntity]
    end

    subgraph Layer4["4_Infrastructure（基础设施层）"]
        Repo[EbookRepository]
        DB[DatabaseConnection]
        Config[ConfigLoader]
    end

    subgraph Layer5["5_Shared（共享工具层）"]
        Errors[AppError]
    end

    subgraph System["⚙️ 组合根 system.js"]
        DI[依赖注入容器]
    end

    User -->|HTTP| Router
    Router --> Controller
    Controller -->|调用| Service
    Service -->|调用| Repo
    Repo -->|使用| DB
    Repo -->|映射| Entity
    Service -->|返回 DTO| DTO
    DI -->|组装| Controller
    DI -->|组装| Service
    DI -->|组装| Repo
    DI -->|加载| Config
    Config -->|提供配置| DB
    Controller -->|使用| Errors
    Service -->|使用| Errors

