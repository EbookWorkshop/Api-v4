    classDef core fill:#fff3e0,stroke:#e65100;
    classDef infra fill:#e8f5e9,stroke:#1b5e20;
    classDef tool fill:#fafafa,stroke:#9e9e9e;
    classDef di fill:#ffebee,stroke:#c62828;

    class Layer1 outer;
    class Layer2 inner;
    class Layer3 core;
    class Layer4 infra;
    class Layer5 tool;
    class System di;
