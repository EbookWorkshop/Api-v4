flowchart TB
%%    title: "EBook Workshop 系统逻辑架构图（依赖注入视角）"

    subgraph L1["1-Interfaces 接口适配层"]
        direction TB
        API["🌐 HTTP / WebSocket 网关<br/>路由 · 中间件 · 控制器<br/>+ DTO 契约"]
    end

    subgraph L2["2-Application 应用层"]
        direction TB
        APP["⚙️ 业务服务聚合<br/>图书 · 网文 · 校阅 · 导出 · 邮件"]
        TASK["🧵 异步任务引擎<br/>任务调度 · 线程池 · 执行器"]
        PORT["🔌 端口接口（SPI）<br/>应用层定义的<strong>行为契约</strong><br/>如：数据访问 · 文件操作 · 抓取 · 邮件"]
    end

    subgraph L3["3-Domain 领域层"]
        DOMAIN["📖 领域模型<br/>实体 · 值对象 · 常量 · 业务规则"]
    end

    subgraph L4["4-Infrastructure 基础设施层"]
        direction TB
        DB["🗄️ 持久化网关<br/>Repository 实现 · SQLite"]
        EXTERNAL["🌍 外部服务适配器<br/>Puppeteer/Axios · Nodemailer · 生成器"]
        FS["📁 文件系统网关<br/>目录扫描 · 读写 · 归档"]
        EVENT["📡 事件总线<br/>跨线程事件发布/订阅"]
    end

    %% ===== 依赖关系（明确区分：依赖 vs. 实现） =====
    %% 接口层 → 应用层（使用）
    API --> APP
    API --> TASK

    %% 应用层内部（依赖抽象）
    APP --> PORT
    APP --> DOMAIN
    TASK --> APP
    TASK --> PORT

    %% 基础设施层实现端口（供应方）
    DB   -.->|供应| PORT
    FS   -.->|供应| PORT
    EXTERNAL -.->|供应| PORT

    %% 领域层独立（不依赖任何外部层）
    %% DB 内部的 ORM 模型引用了领域实体定义（这是代码物理依赖，但逻辑上不画箭头）

    %% 事件总线的横切依赖
    EVENT -.->|发布/订阅| APP
    EVENT -.->|发布/订阅| TASK
    EVENT -.->|发布/订阅| API

    %% ===== 共享工具（隐式） =====
    API -.->|内部引用| SHARED["🛠️ 共享工具（隐式）<br/>错误定义 · 文件大小 · 站点工具"]
    APP -.->|内部引用| SHARED
    DB -.->|内部引用| SHARED

    %% ===== 样式 =====
    style L1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
    style L2 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    style L3 fill:#e0f7fa,stroke:#00695c,stroke-width:2px,color:#000
    style L4 fill:#efebe9,stroke:#4e342e,stroke-width:2px,color:#000

    style API fill:#e3f2fd,stroke:#1565c0,stroke-width:1px
    style APP fill:#fff3e0,stroke:#e65100,stroke-width:1px
    style TASK fill:#fce4ec,stroke:#c62828,stroke-width:1px
    style PORT fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px
    style DOMAIN fill:#e0f7fa,stroke:#00695c,stroke-width:1px
    style DB fill:#efebe9,stroke:#4e342e,stroke-width:1px
    style EXTERNAL fill:#efebe9,stroke:#4e342e,stroke-width:1px
    style FS fill:#efebe9,stroke:#4e342e,stroke-width:1px
    style EVENT fill:#fff8e1,stroke:#f57f17,stroke-width:1px
    style SHARED fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px,stroke-dasharray:5 5


