flowchart TB
    subgraph External["🌐 外部请求"]
        User[浏览器 / 前端]
    end

    subgraph Layer1["1-interfaces（接口适配层）"]
        Controller[BookController]
        Router[Router]
        DTO[DTOs]
        Middlewares[Middlewares<br>Error/Logger/Wrapper]
    end

    subgraph Layer2["2-application（应用服务层）"]
        Query[BookQueryService]
        Command[BookCommandService]
        Ports[Ports 抽象接口]
    end

    subgraph Layer3["3-domain（领域模型层）"]
        Entity[EbookEntity]
        Assoc[Associations]
    end

    subgraph Layer4["4-infrastructure（基础设施层）"]
        Repo[EbookRepository]
        DB[databaseConnection]
        Config[ConfigLoader]
    end

    subgraph Layer5["5-shared（共享工具层）"]
        Errors[AppError]
    end

    subgraph System["⚙️ 组合根 system.js"]
        DI[依赖注入容器]
    end

    User -->|HTTP| Router
    Router -->|路由匹配| Controller
    Controller -->|调用| Query
    Controller -->|调用| Command
    Query -->|调用| Repo
    Command -->|调用| Repo
    Repo -->|使用| DB
    Repo -->|映射| Entity
    Entity -->|引用| Assoc
    DI -->|组装| Controller
    DI -->|组装| Query
    DI -->|组装| Command
    DI -->|组装| Repo
    DI -->|加载| Config
    Config -->|提供配置| DB
    Middlewares -.->|包裹| Router

