{
  "openapi": "3.0.0",
  "info": {
    "title": "V2 Book Collector API",
    "version": "0.1.0",
    "description": "分层架构示例 API"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/books": {
      "get": {
        "summary": "获取所有书籍",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookListResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "bookName": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "hotness": {
                  "type": "integer"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "total": {
            "type": "integer"
          }
        }
      }
    }
  },
  "tags": []
}